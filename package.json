{
	"name": "@codeeditorland/extension-recommender",
	"version": "0.0.1",
	"private": false,
	"description": "Deep learning model to recommend the best extension for a given VS Code workspace",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandExtensionRecommender#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandExtensionRecommender/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandExtensionRecommender.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "dist/lib/index.js",
	"module": "dist/lib/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "npm run clean && webpack --mode production",
		"clean": "rimraf dist",
		"prepack": "npm run build",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"mocha": {
		"extension": [
			"ts"
		],
		"require": "ts-node/register",
		"spec": "test/*.test.ts",
		"timeout": "5000"
	},
	"dependencies": {},
	"devDependencies": {
		"@playform/build": "0.2.3",
		"@types/chai": "5.2.1",
		"@types/node": "22.14.1",
		"chai": "5.2.0",
		"esbuild": "0.25.2",
		"node-fetch": "3.3.2",
		"npm-run-all": "4.1.5",
		"onnxruntime-web": "1.21.0",
		"rimraf": "6.0.1",
		"ts-loader": "9.5.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
